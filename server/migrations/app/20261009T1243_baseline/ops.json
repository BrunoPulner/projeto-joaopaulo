  {
    "id": "unique.Category.Category_slug_key",
    "label": "Add unique constraint on \"Category\" (slug)",
    "operationClass": "additive",
    "target": {
      "id": "postgres",
      "details": {
        "schema": "public",
        "objectType": "unique",
        "name": "Category_slug_key",
        "table": "Category"
      }
    },
    "precheck": [
      {
        "description": "ensure constraint \"Category_slug_key\" does not exist",
        "sql": "SELECT NOT EXISTS (SELECT 1 AS \"one\" FROM \"pg_constraint\" AS \"c\" INNER JOIN \"pg_namespace\" AS \"n\" ON \"n\".\"oid\" = \"c\".\"connamespace\" WHERE (\"c\".\"conname\" = $1 AND \"n\".\"nspname\" = $2 AND \"c\".\"conrelid\" = to_regclass($3))) AS \"result\"",
        "params": [
          "Category_slug_key",
          "public",
          "\"public\".\"Category\""
        ]
      }
    ],
    "execute": [
      {
        "description": "add unique constraint \"Category_slug_key\"",
        "sql": "ALTER TABLE \"public\".\"Category\" ADD CONSTRAINT \"Category_slug_key\" UNIQUE (\"slug\")"
      }
    ],
    "postcheck": [
      {
        "description": "verify constraint \"Category_slug_key\" exists",
        "sql": "SELECT EXISTS (SELECT 1 AS \"one\" FROM \"pg_constraint\" AS \"c\" INNER JOIN \"pg_namespace\" AS \"n\" ON \"n\".\"oid\" = \"c\".\"connamespace\" WHERE (\"c\".\"conname\" = $1 AND \"n\".\"nspname\" = $2 AND \"c\".\"conrelid\" = to_regclass($3))) AS \"result\"",
        "params": [
          "Category_slug_key",
          "public",
          "\"public\".\"Category\""
        ]
